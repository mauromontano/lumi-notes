{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_CHAT_MODE": "mock"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true
    },
    "preview-connected": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_CHAT_MODE": "http",
        "EXPO_PUBLIC_LUMI_API_URL": "https://lumi-api-production-fa73.up.railway.app"
      },
      "channel": "preview-connected"
    }
  },
  "submit": {
    "production": {}
  }
}
