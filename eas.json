{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "cocoapods": "1.17.0"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "cocoapods": "1.17.0"
      },
      "env": {
        "EXPO_PUBLIC_CHAT_MODE": "mock"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_CHAT_MODE": "http"
      },
      "ios": {
        "cocoapods": "1.17.0"
      }
    },
    "preview-connected": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_CHAT_MODE": "http",
        "EXPO_PUBLIC_LUMI_API_URL": "https://mauros-mac-mini.tail4c75c9.ts.net"
      },
      "channel": "preview-connected"
    }
  },
  "submit": {
    "production": {}
  }
}
