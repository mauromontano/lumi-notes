{
  "expo": {
    "name": "Lumi",
    "slug": "lumi-notes",
    "scheme": "luminotes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.mauro.luminotes",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Lumi usa el micrófono para grabar mensajes de audio."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {}
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b0e1d",
          "image": "./assets/images/splash-transparent.png",
          "imageWidth": 64
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Lumi usa el micrófono para grabar mensajes de audio.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lumi permite elegir comprobantes para enviarlos al chat.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-asset",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Lumi usa Face ID para confirmar acciones importantes, como mandar un mail o abrir un PR."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ffc6e8b0-3c9e-4f69-b836-ec8a24bcf437"
      }
    },
    "owner": "mauro-montano",
    "platforms": [
      "ios"
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/ffc6e8b0-3c9e-4f69-b836-ec8a24bcf437"
    }
  }
}
